# ------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/campus_events
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/campus_events

# JWT
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Password hashing cost
BCRYPT_ROUNDS=12

# CORS: "*" or a comma-separated list of allowed origins
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Seed admin account (used by `npm run seed` only)
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=Admin@12345

# Set to true to also create sample events when seeding
SEED_SAMPLE_DATA=true
