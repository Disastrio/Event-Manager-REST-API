{
  "info": {
    "_postman_id": "c1a2e3f4-5b6c-4d7e-8f90-1a2b3c4d5e6f",
    "name": "Campus Events API",
    "description": "REST API for a college event platform.\n\nSet `baseUrl` if your server is not on http://localhost:5000/api/v1. Login/register requests automatically store the JWT in the `token` collection variable, and creating an event stores `eventId`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Liveness probe with database state and uptime."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) {",
                  "  pm.collectionVariables.set('token', body.data.token);",
                  "  pm.collectionVariables.set('userId', body.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"ada@campus.edu\",\n  \"password\": \"Passw0rd123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Public sign-up. Always creates a student account and returns a JWT."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) {",
                  "  pm.collectionVariables.set('token', body.data.token);",
                  "  pm.collectionVariables.set('userId', body.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@campus.edu\",\n  \"password\": \"Admin@12345\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Log in. Use the seeded admin credentials after running `npm run seed`."
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Update current user",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada L.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List events (search + pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/events?page=1&limit=10&search=&category=&sort=-createdAt"
          }
        },
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/events/categories"
          }
        },
        {
          "name": "Get event",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/events/{{eventId}}"
          }
        },
        {
          "name": "Create event (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) {",
                  "  pm.collectionVariables.set('eventId', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Annual Hackathon 2026\",\n  \"description\": \"A 24-hour hackathon for students across all departments.\",\n  \"category\": \"Technology\",\n  \"location\": \"Main Auditorium, Block A\",\n  \"startDate\": \"2026-11-20T09:00:00.000Z\",\n  \"endDate\": \"2026-11-21T09:00:00.000Z\",\n  \"capacity\": 200,\n  \"status\": \"published\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/events",
            "description": "Requires an admin token. Update the dates if they are in the past."
          }
        },
        {
          "name": "Update event (admin/organizer)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"capacity\": 250,\n  \"location\": \"Main Auditorium, Block B\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/events/{{eventId}}"
          }
        },
        {
          "name": "Delete event (admin/organizer)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/events/{{eventId}}"
          }
        }
      ]
    },
    {
      "name": "Registrations",
      "item": [
        {
          "name": "Register for event",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/events/{{eventId}}/register"
          }
        },
        {
          "name": "Cancel registration",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/events/{{eventId}}/register"
          }
        },
        {
          "name": "My registrations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/registrations/me?page=1&limit=10&status=registered"
          }
        },
        {
          "name": "Event registrations (admin/organizer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/events/{{eventId}}/registrations?page=1&limit=10"
          }
        }
      ]
    },
    {
      "name": "Users (admin)",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users?page=1&limit=10&role=&search="
          }
        },
        {
          "name": "Change user role",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"admin\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/users/{{userId}}/role"
          }
        }
      ]
    }
  ]
}
